<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Laast.Controls">
    <Styles.Resources>
        <ControlTheme x:Key="{x:Type controls:AppWindow}" TargetType="controls:AppWindow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TransparencyLevelHint" Value="Transparent"/>
            <Setter Property="CanResize" Value="False"/>
            <Setter Property="WindowDecorations" Value="None" />
            <Setter Property="ExtendClientAreaToDecorationsHint" Value="True"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border CornerRadius="{StaticResource Radius-3}" ClipToBounds="True"
                            Background="{DynamicResource MainWindowBackground}">
                        <VisualLayerManager>
                            <DockPanel>
                                <controls:TitleBar DockPanel.Dock="Top"
                                                   Icon="/Assets/app.ico"
                                                   IsMinimizeAvailable="True"
                                                   Title="{TemplateBinding Title}"/>
                                <ContentPresenter Content="{TemplateBinding Content}"/>
                            </DockPanel>
                        </VisualLayerManager>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>
</Styles>