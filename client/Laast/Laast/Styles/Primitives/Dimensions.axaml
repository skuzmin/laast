<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="MainWindowWidth">800</x:Double>
    <x:Double x:Key="MainWindowHeight">600</x:Double>
    <x:Double x:Key="TitleBarIconSize">24</x:Double>
    <x:Double x:Key="TitleBarButtonWidth">48</x:Double>
    <x:Double x:Key="TitleBarButtonHeight">32</x:Double>
    <x:Double x:Key="NavButtonSize">52</x:Double>
    <x:Double x:Key="ScrollBarContainerWidth">12</x:Double>
    <x:Double x:Key="ScrollBarThumbWidth">8</x:Double>
    <x:Double x:Key="GridRowHeight">40</x:Double>
</ResourceDictionary>
