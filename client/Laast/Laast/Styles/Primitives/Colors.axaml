<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BlackColor">#000</Color>
    <Color x:Key="WhiteColor">#fff</Color>
    <Color x:Key="CharcoalColor">#323333</Color>
    <Color x:Key="RedColor">#EE0000</Color>
    <Color x:Key="DarkRedColor">#8b0000</Color>
    <Color x:Key="DarkGrayColor">#8A8F98</Color>
</ResourceDictionary>
