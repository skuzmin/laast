<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Border -->
    <Thickness x:Key="BorderNone">0</Thickness>
    <Thickness x:Key="Border-1">1</Thickness>
    <!-- Padding -->
    <Thickness x:Key="PaddingNone">0</Thickness>
    <Thickness x:Key="PaddingNavBar">12, 8</Thickness>
    <Thickness x:Key="PaddingNavBarButton">8</Thickness>
    <Thickness x:Key="PaddingPageContainer">12, 0</Thickness>
    <Thickness x:Key="PaddingTitleSection">0, 12</Thickness>
    <Thickness x:Key="PaddingPageSection">0, 0, 0, 12</Thickness>
    <Thickness x:Key="PaddingButtonDefault">16, 8</Thickness>
    <Thickness x:Key="PaddingButtonSm">12, 4</Thickness>
    <!-- Margin -->
    <Thickness x:Key="MarginTitleBarIcon">12,0,0,0</Thickness>
</ResourceDictionary>