<controls:AppWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:Laast.ViewModels"
                    xmlns:controls="using:Laast.Controls"
                    x:Class="Laast.Views.MainWindow"
                    x:DataType="vm:MainWindowViewModel"
                    Title="[LAAST] Lineage II Assistant"
                    Width="{StaticResource MainWindowWidth}"
                    Height="{StaticResource MainWindowHeight}"
                    Topmost="True">

    <StackPanel x:Name="RootPanel">
        <TextBlock Text="{Binding Greeting}"
                   Foreground="{StaticResource TextPrimary}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Button Classes="btn primary" Content="Save" />
        <Button Classes="btn secondary" Content="Cancel"/>
        <Button Classes="btn danger sm" Content="Delete"/>
    </StackPanel>
</controls:AppWindow>