<controls:AppWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:Laast.ViewModels"
                    xmlns:controls="using:Laast.Controls"
                    x:Class="Laast.Views.MainWindow"
                    x:DataType="vm:MainWindowViewModel"
                    Title="[LAAST] Lineage II Assistant"
                    Width="{StaticResource MainWindowWidth}"
                    Height="{StaticResource MainWindowHeight}"
                    Topmost="True">

    <ContentControl x:Name="RootContainer" 
                    Background="Transparent"
                    Content="{Binding CurrentPage}" />
</controls:AppWindow>