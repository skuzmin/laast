<controls:AppWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:Laast.ViewModels"
                    xmlns:controls="using:Laast.Controls"
                    x:Class="Laast.Views.MainWindow"
                    x:DataType="vm:MainWindowViewModel"
                    Title="[LAAST] Lineage II Assistant"
                    Width="{StaticResource MainWindowWidth}"
                    Height="{StaticResource MainWindowHeight}"
                    Topmost="True">
    <Grid x:Name="RootContainer" RowDefinitions="Auto, *">
        <controls:NavBar Grid.Row="0"></controls:NavBar>
        <Border Classes="page-container" Grid.Row="1">
            <ContentControl Background="Transparent" Content="{Binding Navigation.CurrentPage}" />
        </Border>
    </Grid>
</controls:AppWindow>