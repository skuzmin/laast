<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Laast.ViewModels"
             x:Class="Laast.Views.PilotConfigView"
             x:DataType="vm:PilotConfigViewModel">

    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" Classes="title-section">
            <Grid ColumnDefinitions="Auto, 8, *">
                <Button Grid.Column="0" Classes="btn secondary back"
                        Command="{Binding BackCommand}">
                    <Image Source="/Assets/Icons/back.png" />
                </Button>
                <TextBlock Grid.Column="2" Classes="page-title" Text="{Binding Title}"></TextBlock>
            </Grid>
        </Border>
        <Border Grid.Row="1" Classes="page-section"></Border>
    </Grid>
</UserControl>