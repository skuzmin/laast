<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Laast.Client.Controls">
    <Styles.Resources>
        <ControlTheme x:Key="{x:Type controls:AppWindow}" TargetType="controls:AppWindow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TransparencyLevelHint" Value="Transparent" />
            <Setter Property="CanResize" Value="False" />
            <Setter Property="WindowDecorations" Value="None" />
            <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
            <Setter Property="WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border CornerRadius="{StaticResource Radius-3}"
                                ClipToBounds="True"
                                Background="{DynamicResource MainWindowBackground}">
                            <VisualLayerManager>
                                <DockPanel>
                                    <controls:TitleBar DockPanel.Dock="Top"
                                                       Icon="/Assets/app.ico"
                                                       IsMinimizeAvailable="True"
                                                       Title="{TemplateBinding Title}" />
                                    <ContentPresenter Content="{TemplateBinding Content}" />
                                </DockPanel>
                            </VisualLayerManager>
                        </Border>
                        <Border x:Name="PART_OutlineBorder" IsVisible="False" />
                    </Panel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>
</Styles>