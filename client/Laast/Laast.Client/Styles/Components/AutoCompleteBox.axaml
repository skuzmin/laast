<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector=".laast-app AutoCompleteBox">

        <Style Selector="^ /template/ Border#PART_SuggestionsContainer">
            <Setter Property="Background" Value="{DynamicResource AutoCompleteBoxBackground}" />
        </Style>
        <Style Selector="^ /template/ Popup#PART_Popup Border#PART_SuggestionsContainer">
            <Setter Property="Padding" Value="{StaticResource PaddingNone}" />
        </Style>
        <Style Selector="^ /template/ Popup#PART_Popup ListBoxItem">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Padding" Value="{StaticResource PaddingAutoCompleteBox}" />
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource AutoCompleteBoxBackgroundPointerOver}" />
            </Style>
            <Style Selector="^:nth-child(1) /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="CornerRadius" Value="{DynamicResource Radius-ListPopupFirstItem}" />
            </Style>
            <Style Selector="^:nth-last-child(1) /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="CornerRadius" Value="{DynamicResource Radius-ListPopupLastItem}" />
            </Style>
        </Style>
    </Style>
</Styles>