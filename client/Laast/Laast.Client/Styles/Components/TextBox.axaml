<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector=".laast-app TextBox">
        <Setter Property="Background" Value="{DynamicResource TextBlockBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Padding" Value="{StaticResource PaddingTextBox}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextSecondary}"></Setter>
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SelectionBrush" Value="{DynamicResource TextSelectionBackground}" />
        <Style Selector="^:pointerover, ^:focus">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style
            Selector="^:pointerover /template/ Border#PART_BorderElement,
                ^:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource TextBlockBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextBlockActiveBorderBrush}" />
            <Setter Property="BorderThickness" Value="{StaticResource Border-2}" />
        </Style>
        <Style Selector="^ /template/ TextBlock#PART_Placeholder">
            <Setter Property="Foreground" Value="{DynamicResource TextBlockPlaceholderForeground}" />
        </Style>
    </Style>
</Styles>