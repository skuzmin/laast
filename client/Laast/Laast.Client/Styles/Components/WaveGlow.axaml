<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Laast.Client.Controls">

    <Style Selector=".laast-app controls|WaveGlow">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="ClipToBounds" Value="True" />
        <!-- Wrapper -->
        <Style Selector="^ Border#Wrapper">
            <Setter Property="Background" Value="{DynamicResource WaveGlowBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WaveGlowBorderBrush}" />
            <Setter Property="BorderThickness" Value="{StaticResource Border-WaveGlow}" />
        </Style>
        <!-- Wave -->
        <Style Selector="^ Rectangle#Wave">
            <Setter Property="Fill" Value="{DynamicResource WaveGlowWaveBackground}" />
            <Setter Property="Width" Value="{StaticResource WaveGlowWaveWidth}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Effect" Value="blur(3)" />
            <Style.Animations>
                <Animation Duration="0:0:4" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="-320" />
                        <Setter Property="Opacity" Value="0.4" />
                    </KeyFrame>
                    <KeyFrame Cue="45%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="1400" />
                        <Setter Property="Opacity" Value="0.5" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- Glow -->
        <Style Selector="^ Rectangle#Glow">
            <Setter Property="Margin" Value="{StaticResource MarginWaveGlow}" />
            <Setter Property="Effect" Value="blur(14)" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Fill" Value="{DynamicResource WaveGlowGlowBackground}"></Setter>
            <Style.Animations>
                <Animation Duration="0:0:4" IterationCount="INFINITE" PlaybackDirection="Alternate"
                           Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.2" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.6" />
                    </KeyFrame>
                    <KeyFrame Cue="40%">
                        <Setter Property="Opacity" Value="0.9" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.2" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.35" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.8" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Particles -->
        <Style Selector="^ Ellipse">
            <Setter Property="Fill" Value="{DynamicResource WaveGlowParticleBackground}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Effect">
                <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="7" Color="{DynamicResource CyanGlow}" />
            </Setter>
        </Style>

        <Style Selector="^ Ellipse.particle1">
            <Setter Property="Height" Value="{StaticResource WaveGlowParticleM}" />
            <Setter Property="Width" Value="{StaticResource WaveGlowParticleM}" />
            <Style.Animations>
                <Animation Duration="0:0:3" IterationCount="INFINITE" Easing="QuadraticEaseIn">
                    <KeyFrame Cue="12%">
                        <Setter Property="Opacity" Value="0.75" />
                    </KeyFrame>
                    <KeyFrame Cue="65%">
                        <Setter Property="Opacity" Value="0.75" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="12" />
                        <Setter Property="TranslateTransform.Y" Value="-50" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="^ Ellipse.particle2">
            <Setter Property="Height" Value="{StaticResource WaveGlowParticleS}" />
            <Setter Property="Width" Value="{StaticResource WaveGlowParticleS}" />
            <Style.Animations>
                <Animation Duration="0:0:2.5" Delay="0:0:0.5" IterationCount="INFINITE" Easing="QuadraticEaseIn">
                    <KeyFrame Cue="12%">
                        <Setter Property="Opacity" Value="0.75" />
                    </KeyFrame>
                    <KeyFrame Cue="65%">
                        <Setter Property="Opacity" Value="0.75" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="-9" />
                        <Setter Property="TranslateTransform.Y" Value="-40" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="^ Ellipse.particle3">
            <Setter Property="Height" Value="{StaticResource WaveGlowParticleL}" />
            <Setter Property="Width" Value="{StaticResource WaveGlowParticleL}" />
            <Style.Animations>
                <Animation Duration="0:0:3.5" Delay="0:0:1.2" IterationCount="INFINITE" Easing="QuadraticEaseIn">
                    <KeyFrame Cue="12%">
                        <Setter Property="Opacity" Value="0.75" />
                    </KeyFrame>
                    <KeyFrame Cue="65%">
                        <Setter Property="Opacity" Value="0.75" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="15" />
                        <Setter Property="TranslateTransform.Y" Value="-60" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="^ Ellipse.particle4">
            <Setter Property="Height" Value="{StaticResource WaveGlowParticleXs}" />
            <Setter Property="Width" Value="{StaticResource WaveGlowParticleXs}" />
            <Style.Animations>
                <Animation Duration="0:0:2.8" Delay="0:0:0.8" IterationCount="INFINITE" Easing="QuadraticEaseIn">
                    <KeyFrame Cue="12%">
                        <Setter Property="Opacity" Value="0.75" />
                    </KeyFrame>
                    <KeyFrame Cue="65%">
                        <Setter Property="Opacity" Value="0.75" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="-12" />
                        <Setter Property="TranslateTransform.Y" Value="-45" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Style>
</Styles>