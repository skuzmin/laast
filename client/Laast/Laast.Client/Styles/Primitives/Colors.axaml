<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- General -->
    <Color x:Key="BlackColor">#000</Color>
    <Color x:Key="WhiteColor">#fff</Color>
    <Color x:Key="CharcoalColor">#323333</Color>
    <Color x:Key="CharcoalTeal">#FF26323A</Color>
    <Color x:Key="SageGreen">#C9D8D3</Color>
    <Color x:Key="RedColor">#EE0000</Color>
    <Color x:Key="DarkRedColor">#8b0000</Color>
    <Color x:Key="DarkGrayColor">#8A8F98</Color>
    <Color x:Key="BronzeColor">#b8924a</Color>
    <Color x:Key="BronzeLightColor">#d9b46a</Color>
    <Color x:Key="SlateTealColor">#3d4d4a</Color>
    <Color x:Key="SlateTealLightColor">#58716b</Color>
    <Color x:Key="SeafoamColor">#8fb5aa</Color>
    <Color x:Key="RoseColor">#e0606a</Color>
    <Color x:Key="MistColor">#d7e6df</Color>
    <Color x:Key="UmberColor">#211d17</Color>
    <Color x:Key="UmberLightColor">#2c261e</Color>
    <Color x:Key="BlackTransparentColor">#E6202020</Color>
    <!-- Extra -->
    <!-- Extra: WaveGlow -->
    <Color x:Key="DarkCrimson">#E6202020</Color>
    <Color x:Key="MediumSlateCyan">#404BEBFF</Color>
    <Color x:Key="VividCyan">#3300D2FF</Color>
    <Color x:Key="Turquoise">#4D00F5FF</Color>
    <Color x:Key="CyanSoft">#1F00CCFF</Color>
    <Color x:Key="CyanBright">#5C00E1FF</Color>
    <Color x:Key="AquaHighlight">#4766FFF4</Color>
    <Color x:Key="IceCyan">#9BFFFF</Color>
    <Color x:Key="CyanGlow">#7300E0FF</Color>
</ResourceDictionary>