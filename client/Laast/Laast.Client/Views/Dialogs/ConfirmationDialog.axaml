<controls:AppWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Laast.Client.Controls"
                    x:Class="Laast.Client.Views.Dialogs.ConfirmationDialog"
                    SizeToContent="WidthAndHeight"
                    Icon="/Assets/app.ico"
                    Classes="laast-app dialog"
                    Topmost="True">
    <Border Classes="confirmation-dialog">
        <Grid RowDefinitions="Auto, 16, Auto">
            <StackPanel Grid.Row="0">
                <TextBlock Classes="message" x:Name="Message" Text="Message " />
                <TextBlock Classes="sub-message" x:Name="SubMessage" Text="SubMessage " />
            </StackPanel>
            <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto">
                <Button x:Name="CancelButton" Grid.Column="0" Classes="btn secondary" IsCancel="True"
                        Click="CancelButton_OnClick" />
                <Button x:Name="ConfirmButton" Grid.Column="2" Classes="btn danger" IsDefault="True"
                        Click="ConfirmButton_OnClick" />
            </Grid>
        </Grid>
    </Border>
</controls:AppWindow>