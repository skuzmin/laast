<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Laast.Client.Views.Pilot.PilotView"
             xmlns:enums="clr-namespace:Laast.Client.Enums"
             xmlns:pilot="clr-namespace:Laast.Client.ViewModels.Pilot"
             x:DataType="pilot:PilotViewModel">

    <Grid RowDefinitions="Auto, *">
        <!-- Title -->
        <Border Grid.Row="0" Classes="title-section">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <TextBlock Grid.Column="0" Classes="page-title">Pilot</TextBlock>
                <Button Grid.Column="2" Classes="btn primary"
                        Command="{Binding NavigationService.NavigateToPageCommand}"
                        CommandParameter="{x:Static enums:AppPage.PilotConfig}">
                    <StackPanel>
                        <Image Source="/Assets/Icons/add.png" />
                        <TextBlock Text="Add"></TextBlock>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        <Border Grid.Row="1" Classes="page-section">
            <Grid>
                <!-- No Items Message -->
                <TextBlock Classes="no-items-msg"
                           Text="You don't have any configuration yet."
                           IsVisible="{Binding !Configs.Count}" />

                <!-- Data Grid -->
                <DataGrid 
                    ItemsSource="{Binding Configs}" 
                    IsVisible="{Binding Configs.Count}"
                    LoadingRow="ConfigsGrid_OnLoadingRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="5*" Header="Name" Binding="{Binding Name}" />
                        <DataGridTemplateColumn Width="2*" Header="Is Selected">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="pilot:PilotItemViewModel">
                                    <Image Classes="cell-icon" Source="/Assets/Icons/done.png"
                                           IsVisible="{Binding IsSelected}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="2*" Header="Actions">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="pilot:PilotItemViewModel">
                                    <StackPanel Classes="actions-group">
                                        <Button Classes="btn secondary sm"
                                                Command="{Binding  SelectCommand}">
                                            <Image Source="/Assets/Icons/check.png" />
                                        </Button>
                                        <Button Classes="btn secondary sm"
                                                Command="{Binding  EditCommand}">
                                            <Image Source="/Assets/Icons/edit.png" />
                                        </Button>
                                        <Button Classes="btn secondary sm"
                                                Command="{Binding  DeleteCommand}">
                                            <Image Source="/Assets/Icons/delete.png" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>