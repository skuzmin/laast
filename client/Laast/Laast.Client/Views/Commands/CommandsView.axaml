<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Laast.Client.ViewModels"
             xmlns:commands="clr-namespace:Laast.Client.ViewModels.Commands"
             x:Class="Laast.Client.Views.Commands.CommandsView"
             x:DataType="commands:CommandsViewModel">

    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" Classes="title-section">
            <TextBlock Classes="page-title">Commands</TextBlock>
        </Border>
        <Border Grid.Row="1" Classes="page-section"></Border>
    </Grid>
</UserControl>