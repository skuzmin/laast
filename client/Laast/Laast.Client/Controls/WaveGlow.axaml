<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Laast.Client.Controls.WaveGlow">
    <Panel>
        <Border Name="Wrapper" />
        <Rectangle Name="Glow" />
        <Rectangle Name="Wave" />
        <UniformGrid Columns="8">
            <Ellipse Classes="particle1" />
            <Ellipse Classes="particle2" />
            <Ellipse Classes="particle3" />
            <Ellipse Classes="particle4" />
            <Ellipse Classes="particle1" />
            <Ellipse Classes="particle2" />
            <Ellipse Classes="particle3" />
            <Ellipse Classes="particle4" />
        </UniformGrid>
    </Panel>
</UserControl>